{
  "manifest_version": 3,
  "name": "FarsiFix – ترجمه و تبدیل کیبورد",
  "version": "1.0.0",
  "description": "ترجمه سریع متن انتخاب‌شده (پیش‌فرض: انگلیسی به فارسی) و تبدیل خودکار متن فارسیِ تایپ‌شده با کیبورد انگلیسی.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "FarsiFix – تنظیمات",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "ترجمه متن انتخاب‌شده"
    }
  }
}
